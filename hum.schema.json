{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brettinternet/hum/main/hum.schema.json",
  "title": "hum.yaml",
  "description": "Configuration for hum project processes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "processes"],
  "properties": {
    "version": {
      "description": "The hum manifest format version.",
      "const": 1
    },
    "processes": {
      "description": "Named processes managed by hum.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/process"
      }
    }
  },
  "$defs": {
    "processName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "description": "The executable and arguments, without shell interpretation.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "description": "An existing working directory relative to the project root.",
          "type": "string"
        },
        "ready": {
          "$ref": "#/$defs/readiness"
        },
        "after": {
          "description": "Processes that must become ready before this process starts.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/processName"
          }
        },
        "tty": {
          "description": "Run the process in a pseudo-terminal.",
          "type": "boolean",
          "default": false
        },
        "restart": {
          "description": "Whether to restart the process after an unexpected exit.",
          "type": "string",
          "enum": ["never", "on-failure"],
          "default": "never"
        },
        "stop_grace": {
          "description": "Optional non-negative Go duration between SIGTERM and SIGKILL. Omit to inherit the daemon default; 0s kills immediately after the TERM check.",
          "type": "string",
          "pattern": "^[+]?(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|μs|ms|s|m|h))+$"
        }
      }
    },
    "readiness": {
      "description": "Startup readiness: exactly one output matcher or direct executable.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"required": ["match"]}, {"required": ["exec"]}],
      "allOf": [{"if": {"required": ["interval"]}, "then": {"required": ["exec"]}}],
      "properties": {
        "match": {
          "description": "A Go regular expression matched against process output.",
          "type": "string"
        },
        "exec": {
          "description": "Non-empty exact argv executed directly without a shell.",
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "interval": {
          "description": "Positive retry interval for exec readiness; defaults to 1s.",
          "type": "string",
          "pattern": "^(?=.*[1-9])[+]?(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|μs|ms|s|m|h))+$",
          "default": "1s"
        },
        "timeout": {
          "description": "A positive Go duration, such as 500ms, 30s, or 2m.",
          "type": "string",
          "pattern": "^(?=.*[1-9])[+]?(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|μs|ms|s|m|h))+$",
          "default": "30s"
        }
      }
    }
  }
}
